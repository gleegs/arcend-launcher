SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Mode DEV uniquement : URL d'un pack.toml packwiz local (ex: `packwiz serve`
# expose http://localhost:8080/pack.toml). Outrepasse l'URL distante de tous les
# arcs pour tester un modpack local. Ignoré en build packagé.
#ARCEND_PACK_TOML_URL=http://localhost:8080/pack.toml

# Mode DEV uniquement : fichier JSON (tableau d'arcs au format RemoteArc, cf.
# src/electron/types/arc.ts) ajouté aux arcs Supabase. Permet de tester un arc
# de bout en bout sans l'insérer dans Supabase (visible par tous les joueurs).
# Un arc de dev remplace l'arc Supabase de même slug. Ignoré en build packagé.
#ARCEND_DEV_ARCS_FILE=C:/chemin/vers/arcs-dev.json
